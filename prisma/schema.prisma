// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

// The store does not run a fulfilment ladder. An order is PENDING until its
// payment clears, CONFIRMED the instant it does (confirmPaidOrder in
// lib/order-payment.js is the only writer), and CANCELLED if it is pulled.
// Delivery belongs to an external courier from the dispatch email onwards and is
// tracked by AWB number on their side, so nothing here reports on it.
//
// The four middle values are retained only because orders placed under the old
// admin-driven ladder still carry them. Nothing writes them any more; every
// screen must still read and display them.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING // legacy
  SHIPPED // legacy
  OUT_FOR_DELIVERY // legacy
  DELIVERED // legacy
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Who pulled the trigger on a cancellation. Amazon shows this to the customer
// ("Cancelled by you" vs "Cancelled by seller"), so it is worth recording.
enum CancelledBy {
  CUSTOMER
  ADMIN
}

// Type of a homepage block. Each value maps to a renderer component on the
// public homepage. Adding a new visual style for the homepage means adding a
// value here and a matching case in the HomeSections renderer — the admin can
// then create/reorder/fill that block from the Home Builder with no code change.
enum HomeSectionType {
  VIDEO_CAROUSEL // Full-bleed background-video cards (e.g. My Face)
  DEAL_GRID // Amazon-style deal cards (usually linked to products)
  CATEGORY_GRID // Image cards linking to categories
  PRODUCT_CAROUSEL // Featured products carousel (linked to products)
  PROMO_ADS // Promotional ad banners
  REVIEWS // Customer testimonials
  STATS_BAR // Marquee strip of live metrics + static trust promises
  BEST_SELLERS // Top products by units actually sold (paid orders only)
  RECENTLY_VIEWED // Per-shopper "continue shopping" strip, read from the browser
}

// Which public page a CMS section is rendered on. The homepage, product detail,
// and category detail pages each pull the active sections for their placement
// and render them with the shared HomeSections renderer. CHECKOUT is special:
// the checkout layout stays fixed in code and only the FIRST active CHECKOUT
// section is shown, as a slim banner above the (locked) checkout steps.
enum SectionPlacement {
  HOME // Public homepage (default; all legacy sections)
  PRODUCT // Every product detail page
  CATEGORY // Every category detail page
  CHECKOUT // Single banner slot atop the locked checkout page
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)

  // ── Affiliate / referral ──────────────────────────────────────────────────
  // The shopper-facing "affiliate ID". Minted once at signup (see
  // src/lib/referral.js) and never changed — it is the handle other people type
  // into the register form, so rotating it would orphan every share link
  // already in the wild. @unique is what makes it usable as a lookup key.
  //
  // Nullable because not every account has one: staff are not in the program at
  // all, and a row created outside the signup route has not been minted one yet
  // (the referrals API does that on first read). Whether an account SHOULD have
  // one is decided by role at read time, not by this column being set.
  referralCode String? @unique
  // Who referred THIS user, resolved from the code they typed at signup. One
  // level only: there is no chain to walk, A referred B and that is the whole
  // relationship. Immutable after signup — an existing account cannot be
  // retro-attributed to a referrer.
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  // The other side: everyone who signed up with this user's code. This is what
  // /dashboard/referrals lists.
  referrals    User[]  @relation("UserReferrals")

  // Amazon's "Turn off Browsing History" switch. While false we neither record
  // new views nor show the shopper their history back — existing rows are kept
  // (removing them is a separate, explicit action) but nothing reads them.
  browsingHistoryEnabled Boolean @default(true)

  // ── Conditions of use ─────────────────────────────────────────────────────
  // When this account accepted the conditions of use, and which revision of
  // them was live at the time (see lib/pages.js → getTermsVersion). Acceptance
  // is the signup click itself — the form carries the notice next to the
  // button, there is no tickbox — so this is the record of that click.
  //
  // Nullable because every account created before this was recorded has no
  // stamp, and because a row created outside the signup route (a seed, an
  // import) never went through the form. Absent means "not recorded", never
  // "declined".
  termsAcceptedAt DateTime?
  termsVersion    String?

  // ── Session revocation ────────────────────────────────────────────────────
  // Any session token minted before this instant is refused (see getSession in
  // src/lib/auth.js). Moved to "now" by every password change and every
  // password reset, which is what actually kicks out a stolen cookie — sessions
  // are self-contained encrypted cookies, so without this stamp there is
  // nothing server-side to invalidate and a thief keeps the account for the
  // remaining 7 days of the token's life.
  //
  // Null means "nothing has ever been revoked", so every otherwise-valid token
  // passes. That is the correct reading for every account that predates this
  // column — it must not sign the whole customer base out on deploy.
  sessionsValidFrom DateTime?

  cartItems         CartItem[]
  orders            Order[]
  reviews           ProductReview[]
  productViews      ProductView[]
  passwordResetOtps PasswordResetOtp[]

  // ── Gift draw programme ───────────────────────────────────────────────────
  // Coupons this customer has earned, and the prizes they are owed. `giftWins`
  // holds both kinds of win: one drawn from their own coupon, and one mirrored
  // to them because they referred a winner. `giftDrawsRun` is the admin side —
  // which draws this account pressed the button on.
  giftCoupons  GiftCoupon[]
  giftWins     GiftDrawWinner[] @relation("GiftDrawWins")
  giftDrawsRun GiftDraw[]       @relation("GiftDrawsRun")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Every referrals page reads one referrer's downline, newest first.
  @@index([referredById, createdAt])
}

// One-time password used by the Amazon-style forgot/reset password flow.
// The plaintext code is NEVER stored — only its SHA-256 hash. A row is valid
// while consumedAt is null, expiresAt is in the future, and attempts <= the cap
// enforced in the API (see src/app/api/auth/reset-password/route.js).
model PasswordResetOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Category {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  description   String?
  imageUrl      String?
  isActive      Boolean    @default(true)
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryTree")
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Product {
  id               String                   @id @default(cuid())
  // Optional: a product may be uncategorized. Nothing in the storefront requires
  // a category — cards, search, the PDF and the buy-box all fall back to showing
  // no category label — so the admin can list a product before deciding where it
  // belongs. `onDelete: SetNull` is what makes deleting a category safe: its
  // products are simply left uncategorized instead of blocking the delete.
  categoryId       String?
  category         Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name             String
  slug             String                   @unique
  // Optional: a product may have no SKU. Nothing in the storefront or checkout
  // keys off it — it is an admin-facing catalogue reference, and the cart, order
  // lines and PDF all identify a product by id/slug — so a listing can go live
  // before the warehouse has assigned a code. Still @unique: Postgres allows any
  // number of NULLs in a unique index, so "no SKU" never collides, while two
  // products can't share a real code.
  sku              String?                  @unique
  shortDescription String?
  description      String?
  price            Decimal                  @db.Decimal(10, 2)
  mrp              Decimal?                 @db.Decimal(10, 2)
  // Per-product delivery charge (seller-fulfilled shipping). Summed across the
  // order and waived once the subtotal clears the free-shipping threshold.
  shippingFee      Decimal                  @default(0) @db.Decimal(10, 2)
  // Optional free-text promo badge shown on the product card (e.g. "Up to 4% off").
  // Null/empty => no badge is rendered. Admin-managed in /admin/products.
  offerLabel       String?
  // Pack size as the shopper reads it: "250 g", "60 capsules", "100 ml". This is
  // product identity, NOT inventory — `stock` always counts whole sellable packs.
  // Kept as a first-class column (rather than just a ProductAttribute row) because
  // the card, cart line and PDF all need it without loading `attributes`, and two
  // sizes of the same item are two Products that would otherwise look identical.
  netQuantity      String?
  // Comma-separated headline ingredients ("Ashwagandha Root, Shatavari, Brahmi").
  // Rendered as its own section on the product page — Amazon treats ingredients as
  // a first-class field for consumables/cosmetics, and UAE (Dubai Municipality /
  // ESMA) requires the disclosure on supplements. Also folded into searchVector so
  // an ingredient query finds products that don't name it in the title.
  keyIngredients   String?
  // Admin-managed extra search terms: synonyms, benefits, use-cases and
  // ingredients that shoppers might type but that aren't in the product name
  // (e.g. "libido, stamina, vitality, aphrodisiac" for an Ashwagandha product).
  // This is what makes a benefit query like "oils for sexual desire" surface the
  // right product even though those exact words appear nowhere in its name.
  searchKeywords   String?
  // Postgres full-text index column. GENERATED ALWAYS (see the migration) from
  // name (weight A) + searchKeywords (A) + keyIngredients (A) +
  // shortDescription (B) + description (C),
  // so it stays in sync automatically on every write. Queried via ts_rank for
  // relevance-ranked search; never written to from application code. Declared as
  // Unsupported so Prisma tracks it without trying to manage its generation rule.
  searchVector     Unsupported("tsvector")?
  stock            Int                      @default(0)
  isFeatured       Boolean                  @default(false)
  isActive         Boolean                  @default(true)
  images           ProductImage[]
  attributes       ProductAttribute[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          ProductReview[]
  homeItems        HomeSectionItem[]
  views            ProductView[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([searchVector], type: Gin)
}

enum MediaType {
  IMAGE
  VIDEO
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  mediaType MediaType @default(IMAGE)
  sortOrder Int       @default(0)
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  sortOrder Int     @default(0)
}

model ProductReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// A signed-in shopper's cart. This is the authoritative copy: it follows them
// across devices and browsers, exactly like Amazon. Signed-out visitors keep a
// cart in their own browser instead (lib/cart-client.js), which is merged into
// this table on sign-in — see mergeGuestCart in lib/cart.js.
//
// Only quantity and selection live here. Price, delivery, name and imagery
// are read from the Product on every request, so a saved cart can never serve a
// stale price the way a browser snapshot can.
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  // Per-line checkbox on the cart screen. Only selected lines are checked out,
  // so the choice has to survive a reload and follow the account to any device.
  selected  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  // Every cart render reads one shopper's lines, oldest first.
  @@index([userId, createdAt])
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  status              OrderStatus   @default(PENDING)
  paymentStatus       PaymentStatus @default(PENDING)
  subtotal            Decimal       @db.Decimal(10, 2)
  shipping            Decimal       @default(0) @db.Decimal(10, 2)
  total               Decimal       @db.Decimal(10, 2)
  // Money already sent back to the customer for this order. Cancellation is the
  // only thing that puts money back (the store does not accept returns), so this
  // is the cancellation refund and paymentStatus flips to REFUNDED once it
  // reaches `total`.
  refundedTotal       Decimal       @default(0) @db.Decimal(10, 2)
  addressSnapshot     Json?
  // Courier consignment details. No longer written by anything: the AWB number
  // lives with the delivery partner, who tracks the parcel on their own system,
  // and the store stopped keeping a second copy of it. Retained so orders from
  // when an admin typed these in still read back correctly, and still exported
  // in the admin CSV for the same reason.
  trackingNumber      String?
  courierName         String?
  // When the courier handed the parcel over. Same story: stamped by the old
  // admin "mark as delivered" action, which no longer exists, so this is null on
  // every order placed since.
  deliveredAt         DateTime?
  // When the dispatch instruction reached the logistics inbox — the courier
  // books the consignment off that email, so an order whose payment cleared
  // while this is still NULL is one nobody has been told to ship. That is what
  // makes it a stored column rather than something inferred from EmailLog: the
  // admin order list queries it directly to flag the gap, and the resend button
  // is the fix. Set only after the provider accepts the message.
  logisticsNotifiedAt DateTime?
  // Which revision of the conditions of use was live when this order was
  // placed. Stamped separately from the buyer's signup stamp because the terms
  // can change between the two, and a purchase dispute is about the terms in
  // force on the day of the purchase. Nullable for orders placed before this
  // was recorded.
  termsVersion        String?
  cancelledAt         DateTime?
  cancelledBy         CancelledBy?
  cancelReason        String?
  items               OrderItem[]
  payments            Payment[]
  // Gift coupons this order earned — one per whole multiple of the qualifying
  // threshold in its subtotal. Minted when the payment clears, voided (never
  // deleted) if the order is later cancelled.
  giftCoupons         GiftCoupon[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  price       Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  // "Continue shopping" asks, for every product in a shopper's history, whether
  // they have already bought it (lib/browsing-history.js). That reads this table
  // by product on every home page load for a signed-in shopper, which without an
  // index is a scan of every line item the store has ever sold.
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // "cod"    — cash collected by the courier on delivery
  // "refund"  — money sent back for a cancellation; `amount` is the refunded
  //             value and `status` is REFUNDED. Sign is implied by the
  //             provider, so the ledger stays additive.
  provider          String
  providerPaymentId String?       @unique // set only by an external gateway; null for COD
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  rawResponse       Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// A single configurable CMS block. The admin creates these in the Content
// Builder; each section belongs to a `placement` (which public page it renders
// on) and the matching page renders every active section for that placement,
// ordered by `position`. A section with no active items renders nothing, so each
// page is driven by what the admin has added — nothing is hardcoded. (Named
// HomeSection for historical reasons; it now backs product/category/checkout
// pages too via `placement`.)
model HomeSection {
  id        String            @id @default(cuid())
  type      HomeSectionType
  placement SectionPlacement  @default(HOME) // Which public page this renders on
  title     String? // Main heading shown above the block
  eyebrow   String? // Small uppercase label above the heading
  subtitle  String? // Short descriptive paragraph
  position  Int               @default(0)
  isActive  Boolean           @default(true)
  items     HomeSectionItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([isActive, position])
  @@index([placement, isActive, position])
}

// One card/slide/tile inside a HomeSection. The fields are intentionally generic
// so a single shape can back every section type: videos use `videoUrl`, deals
// use `imageUrl`/`badge`/`productId`, categories use `imageUrl`/`href`, reviews
// use `title` (name) + `body` (quote), and so on. `productId` optionally links
// the item to the live product catalog (deals & featured products).
model HomeSectionItem {
  id        String      @id @default(cuid())
  sectionId String
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  position  Int         @default(0)
  isActive  Boolean     @default(true)
  title     String? // Card name / reviewer name
  subtitle  String? // Small label (e.g. brand) / role
  body      String? // Longer text (e.g. review quote, card description)
  imageUrl  String?
  videoUrl  String?
  badge     String? // e.g. "Up to 40% off"
  href      String? // Click-through link
  metric    String? // STATS_BAR only: which live metric to show (see
  // STATS_METRICS in lib/admin-api.js). "STATIC" => plain text.
  productId String?
  product   Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([sectionId, position])
}

// One signed-in shopper's view of one product — the account-side browsing
// history behind the "Continue shopping" strip and the Browsing History page.
//
// Deliberately one row PER USER PER PRODUCT (not per visit): re-viewing a
// product bumps `viewedAt` instead of appending, which is what makes the strip
// "most recent first, no duplicates" without any grouping at read time and caps
// a shopper's rows at the catalog size.
//
// Signed-out browsing is NOT stored here — it stays in the visitor's own browser
// (see lib/recently-viewed.js) and is folded into the account only when they
// sign in. So a row here always belongs to a known, signed-in person.
model ProductView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

// Simple key/value store for editable site-wide settings (contact phone, email,
// address, hours, social links, feature toggles). One row per key.
model SiteSetting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
}

// Editable rich-text page (About, Terms, etc.). The public page renders this
// content with a small markdown subset; falls back to built-in defaults if no
// row exists yet. Edited rarely — the lightweight "page CMS" bucket.
model Page {
  slug      String   @id // "about", "terms"
  title     String
  subtitle  String?
  body      String   @db.Text
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// A single FAQ entry. The FAQ page renders active items ordered by sortOrder.
model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Outcome of a single delivery attempt to the email provider.
enum EmailStatus {
  SENT
  FAILED
  SKIPPED // no valid recipient address — nothing was attempted
}

// Audit trail of every transactional email the app tried to send.
//
// Written by lib/email.js on both success and failure, so "did the customer
// actually get their refund email?" is answerable from the admin panel instead
// of from server logs that have already rolled over. Deliberately stores the
// subject and template name but NOT the rendered body — bodies are large,
// reproducible from the template, and can contain OTP codes.
model EmailLog {
  id        String      @id @default(cuid())
  recipient String
  subject   String
  // Template key, e.g. "order_placed" / "order_cancelled". Lets the admin
  // filter by kind without parsing subject lines.
  template  String
  provider  String
  status    EmailStatus
  error     String?     @db.Text
  // Set when the email is about a specific order, so the admin order screen can
  // show what was sent for it. Intentionally NOT a foreign key: the log must
  // outlive the row it describes.
  orderId   String?
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([orderId])
  @@index([status, createdAt])
}

// Fixed-window counters for the auth rate limiter (src/lib/rate-limit.js).
//
// Lives in the database rather than in process memory because production is
// serverless: instances are many, short-lived, and share nothing else. `key`
// is the primary key so the whole check is a single atomic upsert.
//
// Rows are disposable — they are swept once their window closes, and losing the
// table costs nothing but a reset of the counters.
model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  // Drives the opportunistic sweep of closed windows.
  @@index([expiresAt])
}

// ─── Gift draw programme ─────────────────────────────────────────────────────
//
// Every 100 AED of goods a customer pays for earns them one gift coupon. The
// coupons never expire, but they only take part in a draw if the customer has
// bought something in that draw's cycle — a qualifying purchase reactivates
// EVERY coupon they already hold and mints another one on top, so a regular
// shopper accumulates entries while a one-off shopper's coupon goes dormant.
//
// A draw runs once a month, on the day of the month set by the `gift_draw_day`
// site setting (the 5th unless an admin changes it). Its entry list is frozen
// first (nobody can be added once the cycle closes), then an admin runs it, then
// it is published — and none of those three may happen before the draw's own
// date, which is why every draw stores that date rather than deriving it. If a
// winner was referred by another customer, that referrer wins the same prize —
// one level only, exactly like the rest of the affiliate programme in
// lib/referral.js.

// Where a draw is in its lifecycle. The order is strictly forward: entries can
// only be frozen once, winners can only be picked from a frozen list, and
// publishing is what makes winners visible to customers.
enum GiftDrawStatus {
  SCHEDULED // created, cycle still open, entries still accruing
  FROZEN // entry snapshot taken; the ticket list can no longer change
  DRAWN // winners picked, awaiting admin review
  PUBLISHED // winners visible on /gifts and in customer dashboards
}

// Whether a winner won the prize themselves or is receiving the mirrored copy
// owed to the person who referred them.
enum GiftWinnerKind {
  PRIMARY // their own coupon was drawn
  REFERRER // they referred a PRIMARY winner and get the same prize
}

// How far along handing the prize over has got. Purely operational — the store
// hands these over by arrangement, so this is a checklist for the admin, not a
// workflow anything else keys off.
enum GiftFulfilmentStatus {
  PENDING
  NOTIFIED
  // Retired: the admin screens no longer offer it (see
  // GIFT_FULFILMENT_STATUSES in lib/gift-shared.js, which is what both the
  // dropdown and the API validate against). Kept in the enum so a row written
  // before it was withdrawn still reads back; dropping it would need a
  // migration that rewrote those rows into a state nobody chose for them.
  CLAIMED
  DELIVERED
}

// A promotional poster for the gift programme — the artwork an admin uploads
// and the storefront shows as-is.
//
// The gifts page is an advertisement, not a specification: what sells the
// giveaway is one designed image announcing the prize, the spend needed and the
// draw date, all of which change together every campaign. Storing the finished
// artwork rather than rebuilding it from fields means a new campaign is an
// upload, not a deploy — and it is the reason the page carries no marketing
// prose of its own to fall out of step with the poster.
//
// `linkUrl` is optional: a poster that leads somewhere ("shop now") becomes a
// link, one that is purely informational stays an image.
model GiftPoster {
  id String @id @default(cuid())

  // Doubles as the alt text. Not optional-in-spirit even though the column is:
  // a poster carries ALL of its message in pixels, so a blank alt leaves a
  // screen reader with nothing at all to announce.
  title String?

  imageUrl String
  linkUrl  String?

  // Which surface shows it: "GIFTS" (the public page), "DASHBOARD" (a
  // customer's own gifts screen) or "BOTH". A plain string checked against
  // GIFT_POSTER_PLACEMENTS in lib/gift-shared.js rather than a database enum,
  // so adding a surface later is a code change rather than a migration on a
  // live table.
  placement String @default("BOTH")

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// One prize the programme can award, e.g. "Smart Watch" or "1 Gram Gold Coin".
//
// A single catalogue shared by two very different consumers: the published
// roadmap table on /gifts (via GiftTierItem) and the pool of an individual
// monthly draw (via GiftDrawPrize). They share it because the same prizes recur
// throughout both — "Smart Watch" alone appears in eight roadmap tiers — and a
// second copy of the name would drift.
model GiftPrize {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  // Free text rather than a Decimal on purpose: the published figures are a
  // mixture of currencies and orders of magnitude ("1000 cash prize", "25 lakh
  // villa", "1.5 CR villa in Dubai") and nothing computes on them. They are
  // printed on the roadmap table exactly as the admin types them.
  valueNote String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // Show this prize large in the hero showcase at the top of /gifts, rather
  // than only as a row in the roadmap table. Reserved for the headline items —
  // the car, the villa — that are the reason anybody reads the page at all.
  // A flag rather than "whatever is in the top tier" so the store can lead with
  // whichever prize it wants to sell the programme on this month.
  isFeatured Boolean @default(false)

  // The prize's photographs, lowest sortOrder first. The first one is the cover
  // — it is what every card, thumbnail and email shows — and the rest are extra
  // angles for the pages that can display a gallery.
  images GiftPrizeImage[]

  tierItems  GiftTierItem[]
  drawPrizes GiftDrawPrize[]
  winners    GiftDrawWinner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// One photograph of a prize.
//
// A table rather than a single `imageUrl` column because the headline prizes are
// the reason anybody reads the gifts page, and one photograph rarely sells a car
// or a villa — the store wants the exterior, the interior and the detail shot.
// Ordered rather than a bare set: which image is the COVER is a decision the
// admin makes by dragging it to the top, not something the database picks.
//
// Cascades on delete, because an image has no meaning without its prize.
model GiftPrizeImage {
  id      String    @id @default(cuid())
  prizeId String
  prize   GiftPrize @relation(fields: [prizeId], references: [id], onDelete: Cascade)

  url       String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  @@index([prizeId, sortOrder])
}

// One row of the published prize roadmap — the table customers read on /gifts.
//
// This is marketing content, NOT draw machinery: nothing here decides who wins
// anything. It is stored rather than hardcoded because the roadmap is a
// sixteen-row table of business targets that the company revises, and revising
// it must not need a deploy.
model GiftTier {
  id             String  @id @default(cuid())
  sortOrder      Int     @default(0) // the "SI NO" column
  memberCount    Int // members reached at this rung
  totalMembers   Int? // cumulative members, where the roadmap states one
  targetDays     Int? // days allowed to reach the rung
  totalValueNote String? // e.g. "T = 50000", printed as-is
  isActive       Boolean @default(true)

  items GiftTierItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// A prize line within one roadmap rung: "Smart Watch x 5".
model GiftTierItem {
  id        String    @id @default(cuid())
  tierId    String
  tier      GiftTier  @relation(fields: [tierId], references: [id], onDelete: Cascade)
  prizeId   String
  prize     GiftPrize @relation(fields: [prizeId], references: [id])
  quantity  Int       @default(1)
  sortOrder Int       @default(0)

  @@unique([tierId, prizeId])
  @@index([tierId, sortOrder])
}

// A gift coupon owned by one customer. The customer-facing artefact of the whole
// programme: the code is what is drawn, and `userId` is what turns a drawn code
// back into a person.
//
// Never deleted and never expired. A coupon that should no longer take part —
// its order was cancelled — is stamped `voidedAt` instead, so the reason a code
// stopped being eligible is always on the record.
model GiftCoupon {
  id     String @id @default(cuid())
  code   String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The paid order that earned this coupon. Several coupons share one order
  // when its subtotal covered several multiples of the threshold.
  sourceOrderId String
  sourceOrder   Order  @relation(fields: [sourceOrderId], references: [id])

  // The instant the owner last made a qualifying purchase. THIS is what
  // "active" means: a coupon takes part in a draw when this falls inside the
  // draw's cycle. Set on mint and moved forward — on every coupon the customer
  // holds — by each later qualifying purchase. Never cleared; a dormant coupon
  // is simply one whose stamp has fallen behind the current cycle.
  lastQualifiedAt DateTime

  voidedAt   DateTime?
  voidReason String?

  entries GiftDrawEntry[]
  wins    GiftDrawWinner[]

  createdAt DateTime @default(now())

  // The customer's own list of codes, newest first.
  @@index([userId, createdAt])
  // The eligibility sweep that builds a draw's entry list.
  @@index([lastQualifiedAt])
  @@index([sourceOrderId])
}

// One monthly draw.
model GiftDraw {
  id       String         @id @default(cuid())
  // "2026-09". Unique so a duplicate draw for one month is impossible, which
  // matters because the scheduled freeze and a human can both create one.
  cycleKey String         @unique
  drawDate DateTime
  status   GiftDrawStatus @default(SCHEDULED)

  // The half-open window a coupon's lastQualifiedAt must fall in to enter:
  // [cycleStart, entryCutoff). Stored rather than recomputed so a draw can always
  // explain its own entry list, even after the cadence is changed — which it can
  // be, since the draw day is an admin setting. Recomputing these on read would
  // retroactively redefine which coupons were in a draw that has already run.
  //
  // A draw still SCHEDULED is re-dated when the setting changes (see ensureDraw);
  // one that has been frozen keeps these values for ever.
  cycleStart DateTime
  cycleEnd   DateTime

  // When entries actually close: one cancellation window before cycleEnd.
  //
  // cycleEnd is when the draw is HELD; this is the last instant a purchase can
  // still count towards it. The gap between them is order_cancel_window_hours,
  // and it exists because a coupon whose order is still cancellable must not be
  // in the drum — otherwise a customer can win, cancel for a full refund, and
  // keep the prize, which nothing downstream would ever notice.
  //
  // It is also what consecutive draws tile on: the next draw's cycleStart is the
  // previous draw's entryCutoff, not its cycleEnd. Both edges of the window move
  // by the same amount, so the calendar still tiles exactly — no purchase falls
  // through a gap between two draws, and none is counted by both. A purchase
  // made after a draw's cutoff is not lost; it counts towards the following one.
  entryCutoff DateTime

  // Stamped when the entry snapshot is taken, with the size of that snapshot.
  frozenAt   DateTime?
  entryCount Int       @default(0)

  // Whether one customer may take more than one prize from this draw.
  //
  // Entries accumulate — a regular shopper holds many coupons — so with this
  // off, the heaviest spender can plausibly sweep several prizes at once. On
  // (the default) each customer can be drawn only once per draw and their
  // remaining coupons are skipped. It applies to PRIMARY wins only: a prize
  // mirrored to someone for referring a winner is a separate obligation and is
  // never suppressed by it.
  oneWinPerCustomer Boolean @default(true)

  drawnAt     DateTime?
  drawnById   String?
  drawnBy     User?     @relation("GiftDrawsRun", fields: [drawnById], references: [id], onDelete: SetNull)
  publishedAt DateTime?

  prizes  GiftDrawPrize[]
  entries GiftDrawEntry[]
  winners GiftDrawWinner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, drawDate])
}

// A prize, and how many of it, on offer in one draw. The admin assembles this
// before running the draw; the number of winners picked is the sum of these
// quantities.
model GiftDrawPrize {
  id       String    @id @default(cuid())
  drawId   String
  draw     GiftDraw  @relation(fields: [drawId], references: [id], onDelete: Cascade)
  prizeId  String
  prize    GiftPrize @relation(fields: [prizeId], references: [id])
  quantity Int       @default(1)

  @@unique([drawId, prizeId])
}

// One ticket in the drum: a frozen copy of a coupon that was eligible when the
// cycle closed.
//
// The snapshot is the point. Eligibility is derived from data that keeps moving
// — a customer buys again and every coupon's lastQualifiedAt jumps forward — so
// without freezing there is no way to say afterwards who was actually in the
// draw. `couponCode` and `userId` are copied rather than joined for the same
// reason: the ticket list must still read correctly years later.
model GiftDrawEntry {
  id         String     @id @default(cuid())
  drawId     String
  draw       GiftDraw   @relation(fields: [drawId], references: [id], onDelete: Cascade)
  couponId   String
  coupon     GiftCoupon @relation(fields: [couponId], references: [id])
  couponCode String
  userId     String
  // 0-based index within this draw. The winner is chosen by drawing a position,
  // so this is the number the randomness actually lands on.
  position   Int

  @@unique([drawId, couponId])
  @@unique([drawId, position])
  @@index([drawId, userId])
}

// Someone who is owed a prize from a draw.
//
// A referrer's mirrored prize is a row of its own (kind REFERRER) rather than
// something worked out at display time. Two reasons: the obligation is fixed at
// the moment of the draw and must survive any later change to the referral
// link, and each person's prize is handed over separately, so each needs its own
// fulfilment status.
model GiftDrawWinner {
  id      String    @id @default(cuid())
  drawId  String
  draw    GiftDraw  @relation(fields: [drawId], references: [id], onDelete: Cascade)
  prizeId String
  prize   GiftPrize @relation(fields: [prizeId], references: [id])

  userId String
  user   User   @relation("GiftDrawWins", fields: [userId], references: [id], onDelete: Cascade)

  // The drawn coupon. Null on a REFERRER row — the referrer won nothing of
  // their own; they are owed the prize because of who they referred.
  couponId String?
  coupon   GiftCoupon? @relation(fields: [couponId], references: [id])

  kind                 GiftWinnerKind  @default(PRIMARY)
  // On a REFERRER row, the PRIMARY win that earned it. Lets the admin screen
  // show the pair together, and the @unique is what stops a mirror being
  // created twice for the same win.
  mirroredFromWinnerId String?         @unique
  mirroredFrom         GiftDrawWinner? @relation("GiftWinnerMirror", fields: [mirroredFromWinnerId], references: [id], onDelete: Cascade)
  mirror               GiftDrawWinner? @relation("GiftWinnerMirror")

  status GiftFulfilmentStatus @default(PENDING)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([drawId, kind])
  @@index([userId, createdAt])
}
