
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Who pulled the trigger on a cancellation. Amazon shows this to the customer
// ("Cancelled by you" vs "Cancelled by seller"), so it is worth recording.
enum CancelledBy {
  CUSTOMER
  ADMIN
}

// Lifecycle of a return/replacement request, mirroring the states Amazon shows
// on "Your Returns". REFUNDED / REPLACED / REJECTED / CANCELLED are terminal.
enum ReturnStatus {
  REQUESTED  // customer submitted it; waiting on the seller to approve
  APPROVED   // approved, pickup scheduled
  PICKED_UP  // courier collected the item from the customer
  RECEIVED   // arrived back and passed inspection (stock is restored here)
  REFUNDED   // money sent back — terminal for a REFUND request
  REPLACED   // replacement dispatched — terminal for a REPLACEMENT request
  REJECTED   // seller declined (outside window, item not as described, ...)
  CANCELLED  // customer withdrew the request before pickup
}

// What the customer asked for. Amazon offers both on most items.
enum ReturnResolution {
  REFUND
  REPLACEMENT
}

// The fixed reason list the customer picks from, exactly like Amazon's return
// dropdown. Reasons that mean "the item is unsellable" (DAMAGED / DEFECTIVE)
// deliberately skip the restock step — see lib/returns.js.
enum ReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  MISSING_PARTS
  NOT_AS_DESCRIBED
  NO_LONGER_NEEDED
  BOUGHT_BY_MISTAKE
  BETTER_PRICE
  OTHER
}

// Where the refund money goes. Cash on Delivery has no card to reverse, so the
// customer supplies a destination (bank account) at return time — the same thing
// Amazon does for its Pay-on-Delivery orders.
enum RefundMethod {
  BANK_TRANSFER
  CASH_ON_PICKUP
}

// Type of a homepage block. Each value maps to a renderer component on the
// public homepage. Adding a new visual style for the homepage means adding a
// value here and a matching case in the HomeSections renderer — the admin can
// then create/reorder/fill that block from the Home Builder with no code change.
enum HomeSectionType {
  VIDEO_CAROUSEL   // Full-bleed background-video cards (e.g. My Face)
  DEAL_GRID        // Amazon-style deal cards (usually linked to products)
  CATEGORY_GRID    // Image cards linking to categories
  PRODUCT_CAROUSEL // Featured products carousel (linked to products)
  PROMO_ADS        // Promotional ad banners
  REVIEWS          // Customer testimonials
  STATS_BAR        // Marquee strip of live metrics + static trust promises
  BEST_SELLERS     // Top products by units actually sold (paid orders only)
  RECENTLY_VIEWED  // Per-shopper "continue shopping" strip, read from the browser
}

// Which public page a CMS section is rendered on. The homepage, product detail,
// and category detail pages each pull the active sections for their placement
// and render them with the shared HomeSections renderer. CHECKOUT is special:
// the checkout layout stays fixed in code and only the FIRST active CHECKOUT
// section is shown, as a slim banner above the (locked) checkout steps.
enum SectionPlacement {
  HOME      // Public homepage (default; all legacy sections)
  PRODUCT   // Every product detail page
  CATEGORY  // Every category detail page
  CHECKOUT  // Single banner slot atop the locked checkout page
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  phone        String?         @unique
  passwordHash String
  role         UserRole        @default(CUSTOMER)

  // Amazon's "Turn off Browsing History" switch. While false we neither record
  // new views nor show the shopper their history back — existing rows are kept
  // (removing them is a separate, explicit action) but nothing reads them.
  browsingHistoryEnabled Boolean @default(true)

  addresses    Address[]
  cartItems    CartItem[]
  orders       Order[]
  returns      ReturnRequest[]
  reviews      ProductReview[]
  productViews ProductView[]
  passwordResetOtps PasswordResetOtp[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// One-time password used by the Amazon-style forgot/reset password flow.
// The plaintext code is NEVER stored — only its SHA-256 hash. A row is valid
// while consumedAt is null, expiresAt is in the future, and attempts <= the cap
// enforced in the API (see src/app/api/auth/reset-password/route.js).
model PasswordResetOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  description   String?
  imageUrl      String?
  isActive      Boolean    @default(true)
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryTree")
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Product {
  id               String          @id @default(cuid())
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  name             String
  slug             String          @unique
  sku              String          @unique
  shortDescription String?
  description      String?
  price            Decimal         @db.Decimal(10, 2)
  mrp              Decimal?        @db.Decimal(10, 2)
  // GST slab this product falls under (0/5/12/18/28). Prices are stored
  // GST-INCLUSIVE — exactly like Amazon India — so this rate never adds money on
  // top; it only splits out the tax already inside `price` for the invoice. See
  // lib/pricing.js. Ayurvedic goods commonly sit at 5% or 12%, not 18%.
  gstRate          Int             @default(0)
  // Per-product delivery charge (seller-fulfilled shipping). Summed across the
  // order and waived once the subtotal clears the free-shipping threshold.
  shippingFee      Decimal         @default(0) @db.Decimal(10, 2)
  // Optional free-text promo badge shown on the product card (e.g. "Up to 4% off").
  // Null/empty => no badge is rendered. Admin-managed in /admin/products.
  offerLabel       String?
  // Pack size as the shopper reads it: "250 g", "60 capsules", "100 ml". This is
  // product identity, NOT inventory — `stock` always counts whole sellable packs.
  // Kept as a first-class column (rather than just a ProductAttribute row) because
  // the card, cart line and PDF all need it without loading `attributes`, and two
  // sizes of the same item are two Products that would otherwise look identical.
  netQuantity      String?
  // Comma-separated headline ingredients ("Ashwagandha Root, Shatavari, Brahmi").
  // Rendered as its own section on the product page — Amazon treats ingredients as
  // a first-class field for consumables/cosmetics, and UAE (Dubai Municipality /
  // ESMA) requires the disclosure on supplements. Also folded into searchVector so
  // an ingredient query finds products that don't name it in the title.
  keyIngredients   String?
  // Admin-managed extra search terms: synonyms, benefits, use-cases and
  // ingredients that shoppers might type but that aren't in the product name
  // (e.g. "libido, stamina, vitality, aphrodisiac" for an Ashwagandha product).
  // This is what makes a benefit query like "oils for sexual desire" surface the
  // right product even though those exact words appear nowhere in its name.
  searchKeywords   String?
  // Postgres full-text index column. GENERATED ALWAYS (see the migration) from
  // name (weight A) + searchKeywords (A) + keyIngredients (A) +
  // shortDescription (B) + description (C),
  // so it stays in sync automatically on every write. Queried via ts_rank for
  // relevance-ranked search; never written to from application code. Declared as
  // Unsupported so Prisma tracks it without trying to manage its generation rule.
  searchVector     Unsupported("tsvector")?
  stock            Int             @default(0)
  isFeatured       Boolean         @default(false)
  isActive         Boolean         @default(true)
  images           ProductImage[]
  attributes       ProductAttribute[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          ProductReview[]
  homeItems        HomeSectionItem[]
  views            ProductView[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([searchVector], type: Gin)
}

enum MediaType {
  IMAGE
  VIDEO
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  mediaType MediaType @default(IMAGE)
  sortOrder Int       @default(0)
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  sortOrder Int     @default(0)
}

model ProductReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Decimal       @db.Decimal(10, 2)
  tax             Decimal       @default(0) @db.Decimal(10, 2)
  shipping        Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  // Money already sent back to the customer across every cancellation/return on
  // this order. paymentStatus only flips to REFUNDED once this reaches `total`,
  // so a partial return leaves the order PAID with a smaller balance — the same
  // way Amazon shows "Refunded Rs. X" against a still-delivered order.
  refundedTotal   Decimal       @default(0) @db.Decimal(10, 2)
  addressSnapshot Json?
  // When the courier handed the parcel over. This starts the return window, so
  // it is stamped the moment an admin marks the order DELIVERED.
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy     CancelledBy?
  cancelReason    String?
  items           OrderItem[]
  payments        Payment[]
  returns         ReturnRequest[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  price       Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  // GST captured at purchase time so an invoice/refund is exact even if the
  // product's rate later changes. `tax` is the GST already embedded in `total`
  // (prices are GST-inclusive), NOT an extra charge on top. See lib/pricing.js.
  gstRate     Int     @default(0)
  tax         Decimal @default(0) @db.Decimal(10, 2)
  returnItems ReturnItem[]
}

// A customer's request to send item(s) back. One request covers any subset of an
// order's lines (and any quantity within a line), so a five-item order can have
// several independent returns in flight — again, the Amazon model.
//
// The money side lives on the order: when a request reaches REFUNDED a Payment
// ledger row is written and Order.refundedTotal grows by `refundAmount`.
model ReturnRequest {
  id              String           @id @default(cuid())
  returnNumber    String           @unique
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  status          ReturnStatus     @default(REQUESTED)
  resolution      ReturnResolution @default(REFUND)
  reason          ReturnReason
  comment         String?
  // Item value + its share of tax (+ shipping when the whole order goes back),
  // computed server-side in lib/returns.js — never sent by the client.
  refundAmount    Decimal          @db.Decimal(10, 2)
  refundMethod    RefundMethod?
  refundDetails   Json?            // customer-supplied bank destination snapshot
  refundReference String?          // seller's transfer reference, shown to the customer
  adminNote       String?          // rejection reason / internal note
  items           ReturnItem[]
  requestedAt     DateTime         @default(now())
  approvedAt      DateTime?
  pickedUpAt      DateTime?
  receivedAt      DateTime?
  closedAt        DateTime?        // set when it lands in any terminal status
  updatedAt       DateTime         @updatedAt

  @@index([userId, requestedAt])
  @@index([orderId])
  @@index([status])
}

// One order line inside a return request, with the quantity being sent back and
// the value that quantity contributes to the refund.
model ReturnItem {
  id            String        @id @default(cuid())
  returnId      String
  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId   String
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity      Int
  amount        Decimal       @db.Decimal(10, 2)

  @@index([returnId])
  @@index([orderItemId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // "cod"    — cash collected by the courier on delivery
  // "refund"  — money sent back for a cancellation or return; `amount` is the
  //             refunded value and `status` is REFUNDED. Sign is implied by the
  //             provider, so the ledger stays additive.
  provider          String
  providerPaymentId String?       @unique // set only by an external gateway; null for COD
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  rawResponse       Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// A single configurable CMS block. The admin creates these in the Content
// Builder; each section belongs to a `placement` (which public page it renders
// on) and the matching page renders every active section for that placement,
// ordered by `position`. A section with no active items renders nothing, so each
// page is driven by what the admin has added — nothing is hardcoded. (Named
// HomeSection for historical reasons; it now backs product/category/checkout
// pages too via `placement`.)
model HomeSection {
  id        String            @id @default(cuid())
  type      HomeSectionType
  placement SectionPlacement  @default(HOME) // Which public page this renders on
  title     String?           // Main heading shown above the block
  eyebrow   String?           // Small uppercase label above the heading
  subtitle  String?           // Short descriptive paragraph
  position  Int               @default(0)
  isActive  Boolean           @default(true)
  items     HomeSectionItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([isActive, position])
  @@index([placement, isActive, position])
}

// One card/slide/tile inside a HomeSection. The fields are intentionally generic
// so a single shape can back every section type: videos use `videoUrl`, deals
// use `imageUrl`/`badge`/`productId`, categories use `imageUrl`/`href`, reviews
// use `title` (name) + `body` (quote), and so on. `productId` optionally links
// the item to the live product catalog (deals & featured products).
model HomeSectionItem {
  id        String      @id @default(cuid())
  sectionId String
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  position  Int         @default(0)
  isActive  Boolean     @default(true)
  title     String?     // Card name / reviewer name
  subtitle  String?     // Small label (e.g. brand) / role
  body      String?     // Longer text (e.g. review quote, card description)
  imageUrl  String?
  videoUrl  String?
  badge     String?     // e.g. "Up to 40% off"
  href      String?     // Click-through link
  metric    String?     // STATS_BAR only: which live metric to show (see
                        // STATS_METRICS in lib/admin-api.js). "STATIC" => plain text.
  productId String?
  product   Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([sectionId, position])
}

// One signed-in shopper's view of one product — the account-side browsing
// history behind the "Continue shopping" strip and the Browsing History page.
//
// Deliberately one row PER USER PER PRODUCT (not per visit): re-viewing a
// product bumps `viewedAt` instead of appending, which is what makes the strip
// "most recent first, no duplicates" without any grouping at read time and caps
// a shopper's rows at the catalog size.
//
// Signed-out browsing is NOT stored here — it stays in the visitor's own browser
// (see lib/recently-viewed.js) and is folded into the account only when they
// sign in. So a row here always belongs to a known, signed-in person.
model ProductView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

// Simple key/value store for editable site-wide settings (contact phone, email,
// address, hours, social links, feature toggles). One row per key.
model SiteSetting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
}

// Editable rich-text page (About, Terms, etc.). The public page renders this
// content with a small markdown subset; falls back to built-in defaults if no
// row exists yet. Edited rarely — the lightweight "page CMS" bucket.
model Page {
  slug      String   @id // "about", "terms"
  title     String
  subtitle  String?
  body      String   @db.Text
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// A single FAQ entry. The FAQ page renders active items ordered by sortOrder.
model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}
